# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=taxhandler
DB_PASSWORD=taxhandler_dev_password
DB_DATABASE=taxhandler
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=86400

# NBP API
NBP_API_URL=https://api.nbp.pl/api
NBP_RATE_SOURCE=NBP
NBP_DEFAULT_TABLE=A
NBP_CACHE_TTL=86400

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3001

# JWT (for future authentication)
JWT_SECRET=change_this_in_production
JWT_EXPIRATION=3600

# Logging
LOG_LEVEL=debug
ENABLE_FILE_LOGGING=false
