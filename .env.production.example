# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_VERSION=1.0.0

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=taxhandler
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_DATABASE=taxhandler
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_IN_PRODUCTION
REDIS_TTL=86400

# NBP API
NBP_API_URL=https://api.nbp.pl/api
NBP_RATE_SOURCE=NBP
NBP_DEFAULT_TABLE=A
NBP_CACHE_TTL=86400

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ENABLED=true
CORS_ORIGIN=https://yourdomain.com

# JWT
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRATION=3600

# Logging
LOG_LEVEL=info

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
